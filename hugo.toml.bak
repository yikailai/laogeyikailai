baseURL = "https://www.laogeyikailai.com/"
title = "易开来的后花园"
languageCode = "zh-cn"
defaultContentLanguage = "zh"
hasCJKLanguage = true
theme = "PaperMod"
paginate = 8
enableRobotsTXT = true

[params]
description = "人间烟火，众生百态，皆落笔墨之间；不刻意迎合，只忠实写下自己眼中的世界。"
defaultTheme = "auto"
ShowReadingTime = true
ShowWordCount = true
ShowShareButtons = false
ShowCodeCopyButtons = false
ShowBreadCrumbs = true
ShowPostNavLinks = true
ShowToc = true
TocOpen = false
hideSummary = false

[menu]
[[menu.main]]
name = "首页"
url = "/"
weight = 1

[[menu.main]]
name = "文章"
url = "/posts/"
weight = 2

[[menu.main]]
name = "标签"
url = "/tags/"
weight = 3

[[menu.main]]
name = "搜索"
url = "/search/"
weight = 4

[outputFormats.search]
baseName = "search"
isPlainText = false
mediaType = "application/json"

[outputFormats.RSS]
baseName = "index"
mediaType = "application/rss+xml"

[taxonomies]
tag = "tags"
category = "categories"

[params.footer]
copyright = "© 2026 易开来的后花园 | 原创文字随笔"

[params.assets]
disableFingerprinting = true